  "min_learning_rate": 0.0001,
  "warmup_steps": 1,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "mlm_probability": 0.3,
  "seed": 123,
  "log_every": 1,
  "checkpoint_every": 2,
  "precision": "fp32"
}
