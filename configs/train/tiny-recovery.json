{
  "name": "tiny-recovery",
  "model_config": "configs/model/tiny.json",
  "tokenizer_json": "tests/fixtures/tiny_tokenizer.json",
  "train_glob": "tests/fixtures/train/*.csv",
  "output_dir": "artifacts/tiny-recovery",
  "sequence_length": 16,
  "micro_batch_size": 2,
  "gradient_accumulation_steps": 2,
  "max_steps": 4,
