{
  "schema_version": 1,
  "name": "scratch-tiny-recovery",
  "run_kind": "scale_test",
  "model_config": "configs/scratch/model/openprotein-scratch-tiny.json",
  "tokenizer_json": "configs/scratch/tokenizer/esm2-33.json",
  "train_glob": "tests/fixtures/train/*.csv",
  "data_format": "csv",
  "data_manifest": null,
  "output_dir": "artifacts/scratch-tiny-recovery",
  "sequence_length": 32,
  "micro_batch_token_budget": 32,
  "max_micro_batch_size": 8,
  "gradient_accumulation_steps": 2,
  "max_steps": 4,
  "target_tokens": null,
  "learning_rate": 0.0004,
  "min_learning_rate": 0.00004,
  "warmup_steps": 1,
  "weight_decay": 0.1,
  "beta1": 0.9,
  "beta2": 0.98,
  "adam_epsilon": 1e-8,
  "max_grad_norm": 1.0,
  "mlm_probability": 0.15,
  "seed": 1701,
  "log_every": 1,
  "checkpoint_every": 2,
  "checkpoint_at_start": true,
  "precision": "bf16",
  "activation_checkpointing": true,
  "fsdp_shard_size": 1
}
